{
  "name": "nft-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=11.28.7 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && vite build",
    "build:demo": "tsr generate && vite build --mode demo",
    "preview": "vite preview",
    "routes": "tsr generate",
    "typecheck": "tsr generate && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "tsr generate && eslint . && node scripts/check-clean.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "lighthouse": "node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/roboto-mono": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@msw/data": "1.1.8",
    "@mswjs/socket.io-binding": "0.2.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "msw": "2.15.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-cli": "^1.167.45",
    "@tanstack/router-plugin": "1.168.47",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
